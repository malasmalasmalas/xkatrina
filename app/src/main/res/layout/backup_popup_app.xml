                                android:id="@+id/im_06"
                                android:padding="@dimen/fu4dp"
                                android:focusable="false"
                                android:layout_width="@dimen/fu22dp"
                                android:layout_height="@dimen/fu22dp"
                                android:src="@drawable/default_image"
                                android:scaleType="fitCenter"/>
                            <TextView
                                android:textSize="@dimen/fu8sp"
                                android:id="@+id/tv_016"
                                android:paddingTop="@dimen/fu2dp"
