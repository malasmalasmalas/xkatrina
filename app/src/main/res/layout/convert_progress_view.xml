<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ln_01"
        android:padding="@dimen/fu8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/fu12sp"
            android:id="@+id/tv_title"
            android:padding="@dimen/fu8dp"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jangan menutup aplikasi"/>
        <TextView
            android:textSize="@dimen/fu10sp"
            android:id="@+id/tv_message"
            android:padding="@dimen/fu8dp"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_pbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/pbar_unix"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingTop="@dimen/fu8dp"
                android:paddingRight="@dimen/fu8dp"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="false"
                style="?android:attr/progressBarStyleHorizontal"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ln_02"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingRight="@dimen/fu8dp"
                android:paddingBottom="@dimen/fu8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/fu10sp"
                    android:id="@+id/tv_size"
                    android:paddingLeft="@dimen/fu8dp"
                    android:paddingRight="@dimen/fu8dp"
                    android:paddingBottom="@dimen/fu8dp"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ln_03"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/fu5dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/fu10sp"
                    android:textStyle="bold"
                    android:id="@+id/tv_total"
                    android:paddingLeft="@dimen/fu8dp"
                    android:paddingRight="@dimen/fu8dp"
                    android:paddingBottom="@dimen/fu8dp"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="@dimen/fu12sp"
            android:layout_gravity="right"
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/fu4dp"
            android:text="Selesai"
            style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>
</LinearLayout>
