<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/vscr_1"
        android:padding="@dimen/fu8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_01"
            android:padding="@dimen/fu2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/fu10sp"
                android:id="@+id/tv_agree"
                android:padding="@dimen/fu8dp"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/fu30dp"
                android:text="TextView"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/fu10sp"
                android:textStyle="bold"
                android:id="@+id/tv_agree2"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingTop="@dimen/fu2dp"
                android:paddingRight="@dimen/fu8dp"
                android:paddingBottom="@dimen/fu2dp"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
            <EditText
                android:textSize="@dimen/fu12sp"
                android:id="@+id/et_agree"
                android:padding="@dimen/fu8dp"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:textSize="@dimen/fu12sp"
        android:layout_gravity="right"
        android:id="@+id/btn_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/fu8dp"
        android:layout_marginBottom="@dimen/fu8dp"
        android:text="@string/agree_button"
        style="@style/Widget.Material3.Button.TextButton"/>
</LinearLayout>
