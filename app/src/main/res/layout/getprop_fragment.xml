<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ln_base"
        android:padding="@dimen/fu8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ln_top"
            android:padding="@dimen/fu8dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fu80dp">
            <TextView
                android:textSize="@dimen/fu22sp"
                android:textStyle="bold"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"/>
            <TextView
                android:textSize="@dimen/fu15sp"
                android:textStyle="bold"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/ln_qrcode_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/fu15sp"
                android:id="@+id/tv_qrcode"
                android:padding="@dimen/fu8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fu8dp"
                android:text="Get Prop Tool"
                android:singleLine="true"/>
            <com.google.android.material.card.MaterialCardView
                android:orientation="vertical"
                android:id="@+id/mc_qrcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="@null"
                app:strokeColor="#00000000"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ln_qrcode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/im_qrcode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/default_image"
                        android:scaleType="fitCenter"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="@dimen/fu9sp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_desc"
                android:padding="@dimen/fu8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fu8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
