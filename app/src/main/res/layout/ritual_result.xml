<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ln_base"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_prop"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/fu9sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/tv_01"
                android:paddingLeft="@dimen/fu4dp"
                android:paddingTop="@dimen/fu2dp"
                android:paddingRight="@dimen/fu2dp"
                android:paddingBottom="@dimen/fu2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="system.prop"/>
            <ScrollView
                android:id="@+id/vsprop"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/fu7sp"
                    android:id="@+id/tv_prop"
                    android:paddingLeft="@dimen/fu4dp"
                    android:paddingTop="@dimen/fu2dp"
                    android:paddingRight="@dimen/fu2dp"
                    android:paddingBottom="@dimen/fu2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TextView"/>
            </ScrollView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_cleaner"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/fu9sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/tv_02"
                android:paddingLeft="@dimen/fu4dp"
                android:paddingTop="@dimen/fu2dp"
                android:paddingRight="@dimen/fu2dp"
                android:paddingBottom="@dimen/fu2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="timepick"/>
            <ScrollView
                android:id="@+id/vscleaner"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/fu7sp"
                    android:id="@+id/tv_cleaner"
                    android:paddingLeft="@dimen/fu4dp"
                    android:paddingTop="@dimen/fu2dp"
                    android:paddingRight="@dimen/fu2dp"
                    android:paddingBottom="@dimen/fu2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TextView"/>
            </ScrollView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_wipe"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/fu9sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/tv_03"
                android:paddingLeft="@dimen/fu4dp"
                android:paddingTop="@dimen/fu2dp"
                android:paddingRight="@dimen/fu2dp"
                android:paddingBottom="@dimen/fu2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="wipe gms"/>
            <ScrollView
                android:id="@+id/vswipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/fu7sp"
                    android:id="@+id/tv_wipe"
                    android:paddingLeft="@dimen/fu4dp"
                    android:paddingTop="@dimen/fu2dp"
                    android:paddingRight="@dimen/fu2dp"
                    android:paddingBottom="@dimen/fu2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TextView"/>
            </ScrollView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_ssaid"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/fu9sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/tv_04"
                android:paddingLeft="@dimen/fu4dp"
                android:paddingTop="@dimen/fu2dp"
                android:paddingRight="@dimen/fu2dp"
                android:paddingBottom="@dimen/fu2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="settings_ssaid"/>
            <ScrollView
                android:id="@+id/vsssaid"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/fu7sp"
                    android:id="@+id/tv_ssaid"
                    android:paddingLeft="@dimen/fu4dp"
                    android:paddingTop="@dimen/fu2dp"
                    android:paddingRight="@dimen/fu2dp"
                    android:paddingBottom="@dimen/fu2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TextView"/>
            </ScrollView>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_reboot"
            android:background="#191919"
            android:paddingBottom="@dimen/fu8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/fu12sp"
                android:textStyle="bold"
                android:id="@+id/tv_05"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingTop="@dimen/fu8dp"
                android:paddingRight="@dimen/fu8dp"
                android:paddingBottom="@dimen/fu4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/fu8sp"
                android:id="@+id/tv_reboot"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingTop="@dimen/fu4dp"
                android:paddingRight="@dimen/fu8dp"
                android:paddingBottom="@dimen/fu8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
