<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.card.MaterialCardView
        android:orientation="vertical"
        android:id="@+id/mvc_base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fu24dp"
        android:layout_marginTop="@dimen/fu8dp"
        android:layout_marginRight="@dimen/fu24dp"
        android:layout_marginBottom="@dimen/fu8dp"
        app:cardCornerRadius="@dimen/fu20dp"
        style="@style/Widget.Material3.CardView.Filled">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ln_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ln_dialog"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingTop="@dimen/fu8dp"
                android:paddingRight="@dimen/fu8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/fu12sp"
                    android:id="@+id/tv_backup_title"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buat Backup"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ln_top_backup"
                    android:paddingLeft="@dimen/fu8dp"
                    android:paddingTop="@dimen/fu2dp"
                    android:paddingRight="@dimen/fu8dp"
                    android:paddingBottom="@dimen/fu2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.chip.ChipGroup
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ln_chip_group"
                        android:paddingTop="@dimen/fu2dp"
                        android:paddingBottom="@dimen/fu2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:chipSpacingHorizontal="3dp"
                        app:chipSpacingVertical="2dp"
                        app:singleSelection="true">
                        <com.google.android.material.chip.Chip
                            android:textSize="@dimen/fu9sp"
                            android:gravity="center"
                            android:id="@+id/m_normal"
                            android:padding="@dimen/fu1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/fu1dp"
                            android:text="NORMAL"
                            app:chipMinHeight="@dimen/fu24dp"
                            app:chipMinTouchTargetSize="@dimen/fu28dp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip
                            android:textSize="@dimen/fu9sp"
                            android:gravity="center"
                            android:id="@+id/m_custom"
                            android:padding="@dimen/fu1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/fu1dp"
                            android:text="CUSTOM BACKUP"
                            app:chipMinHeight="@dimen/fu24dp"
                            app:chipMinTouchTargetSize="@dimen/fu28dp"
                            style="@style/Widget.MaterialComponents.Chip.Choice"/>
                    </com.google.android.material.chip.ChipGroup>
                    <com.google.android.material.button.MaterialButton
                        android:textSize="@dimen/fu7sp"
                        android:id="@+id/btn_add_rules"
                        android:paddingLeft="0dp"
                        android:paddingTop="0dp"
                        android:paddingRight="0dp"
                        android:paddingBottom="0dp"
                        android:layout_width="@dimen/fu30dp"
                        android:layout_height="@dimen/fu30dp"
                        app:icon="@drawable/ic_add_rules"
                        app:iconGravity="textStart"
                        style="@style/Widget.Material3.Button.IconButton"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:orientation="vertical"
                    android:id="@+id/til_1"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nomer"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <AutoCompleteTextView
                        android:enabled="false"
                        android:textSize="@dimen/fu12sp"
                        android:id="@+id/tv_number"
                        android:padding="@dimen/fu8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nomer Backup"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:orientation="vertical"
                    android:id="@+id/til_2"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <AutoCompleteTextView
                        android:enabled="false"
                        android:textSize="@dimen/fu12sp"
                        android:id="@+id/tv_location"
                        android:padding="@dimen/fu8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Lokasi Backup"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:orientation="vertical"
                    android:id="@+id/til_3"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <AutoCompleteTextView
                        android:enabled="false"
                        android:textSize="@dimen/fu12sp"
                        android:id="@+id/tv_app"
                        android:padding="@dimen/fu8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Aplikasi"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ln_backup_add"
                    android:paddingLeft="@dimen/fu8dp"
                    android:paddingTop="@dimen/fu4dp"
                    android:paddingRight="@dimen/fu8dp"
                    android:paddingBottom="@dimen/fu8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/fu8sp"
                        android:id="@+id/tv_desc"
                        android:paddingTop="@dimen/fu8dp"
                        android:paddingRight="@dimen/fu8dp"
                        android:paddingBottom="@dimen/fu8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Backup Tambahan"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="@dimen/fu10sp"
                        android:gravity="center"
                        android:id="@+id/msc_ssaid"
                        android:padding="@dimen/fu8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="settings_ssaid"
                        android:layout_weight="1"
                        app:switchPadding="8dp"
                        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:textSize="@dimen/fu10sp"
                        android:gravity="center"
                        android:id="@+id/msc_prop"
                        android:padding="@dimen/fu8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="system.prop"
                        android:layout_weight="1"
                        app:switchPadding="8dp"
                        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
                </LinearLayout>
                <ScrollView
                    android:id="@+id/vscr_1"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ln_prop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </ScrollView>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ln_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button
                        android:textSize="@dimen/fu12sp"
                        android:layout_gravity="right"
                        android:id="@+id/btn_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/fu8dp"
                        android:layout_marginRight="@dimen/fu8dp"
                        android:layout_marginBottom="@dimen/fu8dp"
                        android:text="More"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.Button.TextButton"/>
                    <Button
                        android:textSize="@dimen/fu12sp"
                        android:layout_gravity="right"
                        android:id="@+id/btn_batal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/fu8dp"
                        android:layout_marginRight="@dimen/fu8dp"
                        android:layout_marginBottom="@dimen/fu8dp"
                        android:text="Batal"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.Button.TextButton"/>
                    <Button
                        android:textSize="@dimen/fu12sp"
                        android:layout_gravity="right"
                        android:id="@+id/btn_oke"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Oke"
                        android:layout_weight="1"
                        style="@style/Widget.Material3.Button.TextButton"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ln_proses"
                android:paddingLeft="@dimen/fu8dp"
                android:paddingRight="@dimen/fu8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/fu12sp"
                    android:id="@+id/tv_proses_title"
                    android:padding="@dimen/fu8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/fu8dp"
                    android:layout_marginTop="@dimen/fu8dp"
                    android:text="Loading"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ln_proses_content"
                    android:paddingLeft="@dimen/fu8dp"
                    android:paddingRight="@dimen/fu8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ln_lottie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottie1"
                            android:layout_width="@dimen/fu30dp"
                            android:layout_height="@dimen/fu30dp"
                            android:layout_margin="@dimen/fu10dp"
                            android:scaleType="fitCenter"
                            android:layout_centerInParent="true"
                            app:lottie_autoPlay="true"
                            app:lottie_colorFilter="?attr/colorAccent"
                            app:lottie_fileName="anim_loading.json"
                            app:lottie_loop="true"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/fu11sp"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_proses_backup"
                        android:padding="@dimen/fu8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mohon menunggu"/>
                </LinearLayout>
                <Button
                    android:textSize="@dimen/fu12sp"
                    android:layout_gravity="right"
                    android:id="@+id/btn_close"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/fu8dp"
                    android:layout_marginRight="@dimen/fu8dp"
                    android:layout_marginBottom="@dimen/fu8dp"
                    android:text="Tutup"
                    style="@style/Widget.Material3.Button.TextButton"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
